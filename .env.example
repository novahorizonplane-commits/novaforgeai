# OpenAI
OPENAI_API_KEY="sk-..."

# Application
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"

# Blockchain RPC URLs (for testing)
NOVA_CHAIN_RPC="https://rpc.novachain.io"
LUMENET_RPC="https://rpc.lumenet.io"
JUPITER_CHAIN_RPC="https://rpc.jupiterchain.io"

# Deployment
RAILWAY_TOKEN="your-railway-token"
VERCEL_TOKEN="your-vercel-token"
